<Window x:Class="DesktopApp.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="API Текстовый Запрос" Height="400" Width="600"
     WindowStartupLocation="CenterScreen"
     Background="#FAFAFA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Ввод -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
            <RowDefinition Height="*"/>
            <!-- Результат -->
        </Grid.RowDefinitions>
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Введите запрос:" 
               FontSize="18" FontWeight="Bold"
               Margin="0,0,0,10" Foreground="#444" />

        <!-- Поле ввода -->
        <TextBox x:Name="InputTextBox"
             Grid.Row="1"
             Height="100"
             FontSize="14"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             Padding="10"
             VerticalScrollBarVisibility="Auto"
             Background="#FFFFFF"
             BorderBrush="#CCC"
             BorderThickness="1"
             Margin="0,0,0,10"
             Foreground="#222" />

        <!-- Кнопка отправки -->
        <Button x:Name="SendButton"
            Grid.Row="2"
            Content="Отправить"
            Width="120" Height="40"
            Margin="0,0,0,10"
            HorizontalAlignment="Left"
            FontSize="16"
            Background="#007ACC"
            Foreground="White"
            BorderBrush="#005A9E"
            BorderThickness="1"
            Cursor="Hand"
            Click="SendButton_Click" />

        <!-- Результат -->
        <Border Grid.Row="3"
            CornerRadius="8"
            Background="#F0F0F0"
            Padding="10"
            BorderThickness="1"
            BorderBrush="#DDD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultTextBlock"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="#333" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>